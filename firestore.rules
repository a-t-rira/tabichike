rules_version = '2';

// たびチケ 共同編集（試験版）用 Firestore セキュリティルール
// 方針
// - ログインは匿名ログインのみ。招待リンク（推測できない旅行ID）を知っている人が読み書きできる
// - 旅行の一覧取得（list）は禁止。IDを知らない旅行は見つけられない
// - 入力の型・文字数はアプリ（SPEC.md）と同じ制限をサーバー側でもかける
// - 旅行そのものの削除は、つくった人（ownerUid）だけ
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共通 ----------
    function signedIn() {
      return request.auth != null;
    }
    function str(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }
    function dateStr(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function timeOrNull(v) {
      return v == null || (v is string && v.matches('^[0-9]{2}:[0-9]{2}$'));
    }
    function dateOrNull(v) {
      return v == null || dateStr(v);
    }
    function stamp(d) {
      return d.updatedAt is timestamp && str(d.updatedBy, 0, 20);
    }
    function tripExists(tripId) {
      return exists(/databases/$(database)/documents/trips/$(tripId));
    }

    // ---------- 旅行 ----------
    function validTrip(d) {
      return d.keys().hasOnly(['title', 'destination', 'startDate', 'endDate', 'members', 'budget', 'color', 'memo',
                               'ownerUid', 'schema', 'createdAt', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['title', 'startDate', 'endDate', 'ownerUid', 'schema', 'createdAt', 'updatedAt', 'updatedBy'])
        && str(d.title, 1, 40)
        && (!('destination' in d) || str(d.destination, 0, 40))
        && dateStr(d.startDate) && dateStr(d.endDate) && d.startDate <= d.endDate
        && (!('members' in d) || (d.members is list && d.members.size() <= 10))
        && (!('budget' in d) || d.budget == null || (d.budget is int && d.budget >= 0 && d.budget <= 99999999))
        && (!('color' in d) || d.color in ['sunset', 'sky', 'mint', 'rose', 'gold'])
        && (!('memo' in d) || str(d.memo, 0, 500))
        && d.schema == 1
        && d.createdAt is timestamp
        && stamp(d);
    }

    match /trips/{tripId} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && tripId.size() >= 20
        && validTrip(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if signedIn()
        && validTrip(request.resource.data)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      // ---------- 旅程 ----------
      match /items/{itemId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && tripExists(tripId) && validItem(request.resource.data);
        allow delete: if signedIn();
      }

      // ---------- 持ち物（チェック状態は保存しない） ----------
      match /packing/{itemId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && tripExists(tripId) && validPacking(request.resource.data);
        allow delete: if signedIn();
      }

      // ---------- 費用 ----------
      match /expenses/{itemId} {
        allow read: if signedIn();
        allow create, update: if signedIn() && tripExists(tripId) && validExpense(request.resource.data);
        allow delete: if signedIn();
      }
    }

    function validItem(d) {
      return d.keys().hasOnly(['date', 'time', 'endTime', 'title', 'category', 'place', 'memo', 'done', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['date', 'title', 'category', 'done', 'updatedAt', 'updatedBy'])
        && dateStr(d.date)
        && (!('time' in d) || timeOrNull(d.time))
        && (!('endTime' in d) || timeOrNull(d.endTime))
        && str(d.title, 1, 40)
        && d.category in ['move', 'sight', 'food', 'stay', 'other']
        && (!('place' in d) || str(d.place, 0, 60))
        && (!('memo' in d) || str(d.memo, 0, 200))
        && d.done is bool
        && stamp(d);
    }

    function validPacking(d) {
      return d.keys().hasOnly(['name', 'category', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['name', 'category', 'updatedAt', 'updatedBy'])
        && str(d.name, 1, 30)
        && d.category in ['valuables', 'devices', 'clothes', 'toiletries', 'other']
        && stamp(d);
    }

    function validExpense(d) {
      return d.keys().hasOnly(['date', 'title', 'amount', 'category', 'memo', 'updatedAt', 'updatedBy'])
        && d.keys().hasAll(['title', 'amount', 'category', 'updatedAt', 'updatedBy'])
        && (!('date' in d) || dateOrNull(d.date))
        && str(d.title, 1, 30)
        && d.amount is int && d.amount >= 1 && d.amount <= 9999999
        && d.category in ['move', 'stay', 'food', 'sight', 'shopping', 'other']
        && (!('memo' in d) || str(d.memo, 0, 100))
        && stamp(d);
    }
  }
}
